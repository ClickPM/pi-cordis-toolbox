{
  "name": "pi-cordis-toolbox",
  "version": "0.1.0",
  "description": "A fixed Pi toolbox_run facade backed by an ephemeral Cordis plugin runtime and nested agent loop.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "cordis",
    "agent-tools"
  ],
  "pi": {
    "extensions": [
      "./extensions/toolbox.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "jiti": "2.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "file:../PiAgent/resources/runtime-seed/node_modules/@earendil-works/pi-agent-core",
    "@earendil-works/pi-ai": "file:../PiAgent/resources/runtime-seed/node_modules/@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent": "file:../PiAgent/resources/runtime-seed/node_modules/@earendil-works/pi-coding-agent",
    "@types/node": "22.19.19",
    "typebox": "file:../PiAgent/resources/runtime-seed/node_modules/@earendil-works/pi-coding-agent/node_modules/typebox",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
