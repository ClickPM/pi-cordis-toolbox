{
  "name": "pi-cordis-toolbox",
  "version": "0.1.1",
  "description": "A fixed Pi toolbox_run facade backed by an ephemeral Cordis plugin runtime and nested agent loop.",
  "type": "module",
  "keywords": [
    "pi-package",
    "cordis",
    "agent-tools"
  ],
  "pi": {
    "extensions": [
      "./extensions/toolbox.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "jiti": "2.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.86.0",
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@types/node": "22.19.19",
    "typebox": "^1.3.27",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickPM/pi-cordis-toolbox.git"
  },
  "homepage": "https://github.com/ClickPM/pi-cordis-toolbox#readme",
  "bugs": {
    "url": "https://github.com/ClickPM/pi-cordis-toolbox/issues"
  },
  "files": [
    "extensions",
    "src",
    "plugins",
    "docs",
    "README.md"
  ]
}
